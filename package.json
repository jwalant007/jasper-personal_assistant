{
  "name": "jasper-assistant",
  "version": "1.0.1",
  "description": "JASPER - Personalized AI Assistant",
  "main": "electron/main.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix server && npm install --prefix client",
    "start": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build:all": "powershell -ExecutionPolicy Bypass -File server/build_all.ps1",
    "watch": "node auto-watcher.js",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run client\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:client && electron-builder"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Antigravity",
  "license": "MIT",
  "build": {
    "appId": "com.antigravity.jasper",
    "productName": "JASPER Assistant",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*.ps1"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JASPER Assistant"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
